web/VaR/index.html linguist-generated=true
web/VaR/app.js linguist-generated=true
web/shared/mapa-kodu.json linguist-generated=true
# Biblioteka cudza (kopia pliku z pakietu npm) i próbki danych: nie liczą się do statystyk języków i zwijają się w podglądzie zmian.
web/shared/vendor/** linguist-vendored=true
data/przyklad/*.json linguist-generated=true
